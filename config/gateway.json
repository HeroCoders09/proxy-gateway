{
  "listen_port": 8000,
  "max_queue_size": 10000,
  "max_retries": 2,
  "policy": "weighted",
  "weights": {
    "w_latency": 0.5,
    "w_load": 0.3,
    "w_failure": 0.2
  },
  "workers": {
    "min": 4,
    "max": 64,
    "initial": 16,
    "alpha": 2,
    "beta": 0.5
  },
  "timeouts": {
    "connect_ms": 2000,
    "response_ms": 10000,
    "probe_interval_ms": 2000
  },
  "circuit": {
    "failure_threshold": 5,
    "cooldown_sec": 10
  },
  "default_rate_limit": {
    "rate": 200.0,
    "burst": 400.0
  },
  "rate_limits": {
    "test.example": {
      "rate": 50.0,
      "burst": 100.0
    },
    "target:9000": {
      "rate": 5000.0,
      "burst": 5000.0
    }
  },
  "proxies": [
    { "host": "127.0.0.1", "port": 8101 },
    { "host": "127.0.0.1", "port": 8102 },
    { "host": "127.0.0.1", "port": 8103 }
  ],
  "probe_target_url": "http://127.0.0.1:9000/health",
  "output": {
    "csv_path": "results.csv",
    "json_path": "results.jsonl"
  }
}
