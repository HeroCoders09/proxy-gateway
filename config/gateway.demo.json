{
  "listen": {"host": "127.0.0.1", "port": 8000},
  "admin": {"host": "127.0.0.1", "port": 9000},
  "proxies": [
    {"host": "127.0.0.1", "port": 3128},
    {"host": "127.0.0.1", "port": 3129},
    {"host": "127.0.0.1", "port": 3130}
  ],
  "policy": "roundrobin",
  "forwarder": "epoll",
  "forwarder_pool": {"max_connections_per_proxy": 16, "max_total_connections": 48, "idle_timeout_ms": 30000},
  "rate_limits": {
    "default": {"rate": 1000, "burst": 2000},
    "site-a.example": {"rate": 50, "burst": 50}
  },
  "queue_limit": 10000,
  "workers": {"min": 4, "max": 64, "alpha": 1, "beta": 0.5},
  "timeouts": {"connect_ms": 2000, "response_ms": 10000},
  "circuit": {"threshold": 5, "cooldown_ms": 10000, "probe_interval_ms": 2000, "window_size": 20},
  "weights": {"latency": 0.5, "load": 0.3, "failure": 0.2},
  "ingress": {"threads": 16, "max_header_bytes": 16384, "max_body_bytes": 1048576, "read_timeout_ms": 5000, "pending_connections": 1024},
  "output": {"format": "csv", "path": "/tmp/phase6-demo-requests.csv"}
}
